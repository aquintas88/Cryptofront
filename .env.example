# Cryptofront · variables de entorno. Solo nombres y descripción; los valores NUNCA van aquí.
# En local: copiar a backend/.env (ignorado por git). En Railway: variables del servicio por entorno.

# Conexión de la aplicación (rol kira_app, sin superusuario, decisión D-03)
DATABASE_URL=
# Conexión de administrador, solo para migraciones y creación del rol (no la usa la app)
DATABASE_URL_ADMIN=
# Clave de firma de sesiones. Mínimo 32 caracteres. Sin valor por defecto.
JWT_SECRET=
# Clave de 32 bytes en base64 para cifrar secretos en reposo (AES-256-GCM). Sin valor por defecto.
SECRETS_MASTER_KEY=
# Opcional. Origen permitido para CORS en producción
FRONTEND_URL=
# Opcional. Puerto HTTP del backend (por defecto 3000)
PORT=

# Correo del sistema (integración de plataforma). Protocolo SMTP genérico.
# Si falta alguna de estas variables, el correo queda desactivado y el resto de la aplicación funciona.
SMTP_HOST=
SMTP_PUERTO=
SMTP_USUARIO=
# Contraseña SMTP. Solo en variables de entorno del servicio, nunca en el repositorio.
SMTP_CONTRASENA=
CORREO_REMITENTE=
